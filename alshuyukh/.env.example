# Public site URL, used for canonical URLs, Open Graph, and the sitemap
NEXT_PUBLIC_SITE_URL=https://alshuyukh.sa

# Analytics (leave empty to disable a provider)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Free shipping threshold in SAR (shown in the cart progress bar)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=500

# Signs order confirmation links (32+ random chars, required in production)
ORDER_TOKEN_SECRET=
# Payment gateway: "mock" for development. Real adapters plug into src/server/payments.
PAYMENT_PROVIDER=mock

# Database (SQLite file) and uploaded images. Must be on a persistent disk.
DATABASE_PATH=./data/alshuyukh.db
UPLOAD_DIR=./data/uploads

# First admin (owner). Used only when no admin exists yet; remove after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
